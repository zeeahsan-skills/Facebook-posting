# Copy to .env.local for local development. Never commit real values.
# Production values are set in Vercel → Project → Settings → Environment Variables.

# Dashboard login password (required). Choose a strong password.
APP_PASSWORD=

# Vercel Blob token — auto-created when a Blob store is connected to the
# project in Vercel → Storage. Do not set manually in production.
BLOB_READ_WRITE_TOKEN=
